---
import TerminalRoot from "@/legacy/TerminalRoot";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Terminal, Aravind Anubothu</title>
    <meta name="description" content="The original terminal version of Aravind Anubothu's portfolio. Type help to start." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:inline>
      html, body { margin: 0; background: #050505; }
    </style>
  </head>
  <body>
    <div id="root" style="height: 100vh">
      <TerminalRoot client:only="react" />
    </div>
    <noscript>
      <p style="color:#e8d5a3;font-family:monospace;padding:24px">
        The terminal needs JavaScript. The main site works without it: <a href="/" style="color:#e8d5a3">go back home</a>.
      </p>
    </noscript>
  </body>
</html>
