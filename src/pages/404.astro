---
import Base from "@/layouts/Base.astro";
---

<Base title="Page not found, Aravind Anubothu" description="This page does not exist.">
  <section class="container nf">
    <p class="mono nf__code">404</p>
    <h1>No route to this page.</h1>
    <p>Even Dijkstra could not find it. Try the home page instead.</p>
    <a class="btn" href="/">Go home</a>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    gap: 16px;
    justify-items: start;
    padding-block: 18vh;
  }

  .nf h1 {
    font-size: var(--step-4);
    font-weight: 800;
  }

  .nf p {
    color: var(--ink-2);
  }

  .nf__code {
    color: var(--signal-text);
  }
</style>
