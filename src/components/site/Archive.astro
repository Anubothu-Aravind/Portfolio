---
import { projects, groupOf, groupsInUse, GROUP_LABEL, GROUP_TAG, STATUS_LABEL } from "@/lib/projects";

const groups = groupsInUse();
const counts = Object.fromEntries(groups.map((g) => [g, projects.filter((p) => groupOf(p) === g).length]));

// spines stand at slightly different heights, like real books (fixed pattern, so it never shifts between builds)
const HEIGHTS = [96, 88, 100, 91, 84, 97, 90, 94, 86, 100];
const first = projects[0];
const firstGroup = groupOf(first);
---

<section id="archive" class="section container ix" aria-labelledby="archive-title" data-ix>
  <h2 id="archive-title" class="ix__title" data-words>
    <span class="ix__accent">everything i’ve built</span>, all {projects.length} of it.<span class="ix__hint"> point at one for a peek.</span>
  </h2>

  <div class="ix__filters" role="group" aria-label="Show projects from" data-ix-filters hidden>
    <span class="ix__pill" aria-hidden="true" data-ix-pill></span>
    <button type="button" class="ix__filter is-active" data-filter="all" aria-pressed="true">
      all <span class="ix__n">{projects.length}</span>
    </button>
    {
      groups.map((g) => (
        <button type="button" class="ix__filter" data-filter={g} aria-pressed="false">
          <span class={`ix__key key--${g}`} aria-hidden="true" />
          {GROUP_LABEL[g]} <span class="ix__n">{counts[g]}</span>
        </button>
      ))
    }
  </div>
  <p class="sr-only" aria-live="polite" data-ix-status></p>

  <!-- the shelf: every project is a spine; pointing (or tapping) pulls it out into the reader below -->
  <ol class="shelf" aria-label="All projects" data-shelf>
    {
      projects.map((p, i) => {
        const g = groupOf(p);
        // the longest titles get the tallest spines and a size smaller, so no name is cut off
        const long = p.name.length > 20;
        return (
          <li class="book" data-book data-group={g} style={`--h: ${long ? 100 : HEIGHTS[i % HEIGHTS.length]}`}>
            <a
              class={`spine spine--${g} ${i === 0 ? "is-on" : ""}`}
              href={`/projects/${p.id}`}
              aria-current={i === 0 ? "true" : undefined}
              data-spine
              data-group={g}
              data-name={p.name}
              data-num={p.index}
              data-kind={GROUP_TAG[g]}
              data-status={p.status}
              data-status-label={STATUS_LABEL[p.status]}
              data-tag={p.tagline}
              data-img={p.image ?? ""}
              data-alt={p.imageAlt ?? ""}
            >
              <span class="spine__num" aria-hidden="true">{p.index}</span>
              <span class={`spine__name ${long ? "spine__name--long" : ""}`}>{p.name}</span>
            </a>
          </li>
        );
      })
    }
  </ol>

  <div class="rd" data-rd data-group={firstGroup}>
    <figure class="rd__shot" data-rd-shot>
      <img
        src={first.image ?? undefined}
        alt={first.imageAlt ?? ""}
        width="1280"
        height="800"
        loading="lazy"
        hidden={!first.image}
        data-rd-img
      />
      <div class="rd__ph" hidden={!!first.image} data-rd-ph>
        <span data-rd-ph-name>{first.name}</span>
      </div>
    </figure>
    <div class="rd__body" data-rd-body>
      <p class="rd__meta">
        <span class="rd__num" data-rd-num>{first.index}</span>
        <span class="rd__kind" data-rd-kind>{GROUP_TAG[firstGroup]}</span>
        <span class={`status status--${first.status}`} data-rd-status>{STATUS_LABEL[first.status]}</span>
      </p>
      <h3 class="rd__name" data-rd-name>{first.name}</h3>
      <p class="rd__tag" data-rd-tag>{first.tagline}</p>
      <a class="btn" href={`/projects/${first.id}`} data-rd-link aria-label={`Open ${first.name}`}>open the project</a>
    </div>
  </div>
</section>

<style>
  .ix__title {
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
    color: var(--muted);
    max-width: 40ch;
    margin-bottom: 28px;
  }

  .ix__accent {
    color: var(--signal-text);
  }

  @media (hover: none) {
    .ix__hint {
      display: none;
    }
  }

  /* ---------- filters: one track, one ink pill that slides ---------- */
  .ix__filters {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    width: fit-content;
    max-width: 100%;
    padding: 4px;
    margin-bottom: 8px;
    border-radius: 24px;
    border: 1px solid var(--line);
    background: var(--paper-2);
  }

  .ix__filters[hidden] {
    display: none;
  }

  .ix__pill {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    border-radius: var(--r-pill);
    background: var(--ink);
    pointer-events: none;
    opacity: 0;
  }

  .ix__filter {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 0 16px;
    border-radius: var(--r-pill);
    border: 0;
    background: transparent;
    color: var(--ink-2);
    font-size: var(--step--1);
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition: color var(--dur-2) linear, transform var(--dur-1) var(--ease-out);
  }

  .ix__filter:hover {
    color: var(--ink);
  }

  .ix__filter:active {
    transform: scale(0.95);
  }

  .ix__filter:focus-visible {
    outline: 2px solid var(--signal-text);
    outline-offset: 2px;
  }

  .ix__filter.is-active {
    color: var(--paper);
  }

  .ix__n {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    opacity: 0.6;
    font-variant-numeric: tabular-nums;
  }

  /* the colour key: each filter shows the spine colour it picks out */
  .ix__key {
    width: 12px;
    height: 12px;
    border-radius: 4px;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ink) 18%, transparent);
  }

  .key--work,
  .spine--work {
    background: var(--pink);
    color: var(--pink-ink);
  }

  .key--mtech,
  .spine--mtech {
    background: var(--name-bg);
    color: var(--ink);
  }

  .key--btech,
  .spine--btech {
    background: var(--mark);
    color: var(--mark-ink);
  }

  .key--side,
  .spine--side {
    background: var(--card);
    color: var(--ink);
  }

  .key--campus,
  .spine--campus {
    background: var(--ink);
    color: var(--paper);
  }

  /* ---------- the shelf ---------- */
  .shelf {
    /* tall enough to read the spines, short enough that the shelf and the reader share one screen */
    --shelf-h: clamp(240px, 36svh, 320px);
    display: flex;
    align-items: flex-end;
    gap: 4px;
    margin: 0;
    padding: 32px 0 12px;
    list-style: none;
  }

  .book {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    max-width: 64px;
    height: calc(var(--shelf-h) * var(--h) / 100);
  }

  /* each book carries its own stretch of shelf board, so wrapped rows get a board too */
  .book::after {
    content: "";
    position: absolute;
    left: -2px;
    right: -2px;
    bottom: -12px;
    height: 12px;
    background: var(--line-strong);
  }

  .book:first-child::after {
    left: 0;
    border-radius: 4px 0 0 4px;
  }

  .book:last-child::after {
    right: 0;
    border-radius: 0 4px 4px 0;
  }

  .spine {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    height: 100%;
    padding: 12px 0 16px;
    border-radius: 8px 8px 4px 4px;
    border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    text-decoration: none;
    overflow: hidden;
    translate: 0 0;
    transition: translate var(--dur-3) var(--ease-spring), opacity var(--dur-2) linear, box-shadow var(--dur-2) var(--ease-out);
  }

  /* a band near the top of every spine, like a printed book */
  .spine::before {
    content: "";
    position: absolute;
    top: 36px;
    left: 0;
    right: 0;
    height: 2px;
    background: currentColor;
    opacity: 0.22;
  }

  .spine__num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    opacity: 0.75;
  }

  .spine__name {
    flex: 1 1 auto;
    min-height: 0;
    padding-top: 8px;
    writing-mode: vertical-rl;
    rotate: 180deg;
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .spine__name--long {
    font-size: 0.8125rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .spine:hover {
      translate: 0 -8px;
    }
  }

  .spine.is-on {
    translate: 0 -20px;
    box-shadow: var(--shadow-lift);
  }

  .spine:focus-visible {
    outline: 2px solid var(--signal-text);
    outline-offset: 3px;
  }

  .spine:active {
    translate: 0 -4px;
  }

  .book.is-off .spine {
    opacity: 0.16;
    translate: 0 4px;
    pointer-events: none;
  }

  /* ---------- the reader ---------- */
  .rd {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: center;
    gap: 48px;
    margin-top: 40px;
  }

  .rd__shot {
    position: relative;
    margin: 0;
    aspect-ratio: 16 / 10;
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    background: var(--paper-2);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .rd__shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .rd__shot [hidden] {
    display: none;
  }

  .rd__ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    padding: 24px;
    text-align: center;
    font-size: var(--step-3);
    font-weight: 800;
    letter-spacing: -0.03em;
    overflow-wrap: break-word;
  }

  .rd[data-group="work"] .rd__ph {
    background: var(--pink);
    color: var(--pink-ink);
  }

  .rd[data-group="mtech"] .rd__ph {
    background: var(--name-bg);
    color: var(--ink);
  }

  .rd[data-group="btech"] .rd__ph {
    background: var(--mark);
    color: var(--mark-ink);
  }

  .rd[data-group="side"] .rd__ph {
    background: var(--card);
    color: var(--ink);
  }

  .rd[data-group="campus"] .rd__ph {
    background: var(--ink);
    color: var(--paper);
  }

  .rd__body {
    display: grid;
    justify-items: start;
    gap: 12px;
    min-width: 0;
  }

  .rd__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .rd__num {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--muted);
  }

  .rd__kind {
    padding: 4px 12px;
    border-radius: var(--r-pill);
    border: 1px solid var(--line);
    color: var(--ink-2);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .rd__name {
    font-size: var(--step-3);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    min-width: 0;
    overflow-wrap: break-word;
  }

  .rd__tag {
    max-width: 36ch;
    color: var(--ink-2);
    font-size: var(--step-1);
    margin-bottom: 8px;
  }

  /* ---------- phones: two shelves of ten and nine, the reader under them ---------- */
  @media (max-width: 720px) {
    .shelf {
      flex-wrap: wrap;
      row-gap: 32px;
      padding-top: 28px;
    }

    .book {
      flex: 0 0 calc((100% - 9 * 4px) / 10);
      max-width: none;
      height: calc(236px * var(--h) / 100);
    }

    .book:nth-child(10)::after {
      right: 0;
      border-radius: 0 4px 4px 0;
    }

    .book:nth-child(11)::after {
      left: 0;
      border-radius: 4px 0 0 4px;
    }

    .spine {
      gap: 8px;
      padding: 8px 0 12px;
      border-radius: 6px 6px 3px 3px;
    }

    .spine::before {
      top: 26px;
    }

    .spine__num {
      font-size: 0.6875rem;
    }

    .spine__name {
      font-size: 0.8125rem;
    }

    .spine__name--long {
      font-size: 0.75rem;
    }

    .spine.is-on {
      translate: 0 -14px;
    }

    .rd {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
      margin-top: 36px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .spine,
    .ix__filter {
      transition: none;
    }
  }
</style>

<script>
  import { animate, stagger, SPRING, reducedMotion, finePointer } from "@/lib/motion";

  type Ease = [number, number, number, number];
  const ARRIVE: Ease = [0.16, 1, 0.3, 1];

  const wire = () => {
    const root = document.querySelector<HTMLElement>("[data-ix]:not([data-wired])");
    if (!root) return;
    root.dataset.wired = "1";

    const ac = new AbortController();
    const { signal } = ac;
    document.addEventListener("astro:before-swap", () => ac.abort(), { once: true });

    const reduced = reducedMotion();
    const books = [...root.querySelectorAll<HTMLElement>("[data-book]")];
    const spines = books.map((b) => b.querySelector<HTMLAnchorElement>("[data-spine]")!);
    const shelf = root.querySelector<HTMLElement>("[data-shelf]")!;

    /* ---- the reader ---- */
    const rd = root.querySelector<HTMLElement>("[data-rd]")!;
    const q = <T extends HTMLElement>(sel: string) => rd.querySelector<T>(sel)!;
    const shot = q("[data-rd-shot]");
    const img = q<HTMLImageElement>("[data-rd-img]");
    const ph = q("[data-rd-ph]");
    const phName = q("[data-rd-ph-name]");
    const body = q("[data-rd-body]");
    const num = q("[data-rd-num]");
    const kind = q("[data-rd-kind]");
    const status = q("[data-rd-status]");
    const name = q("[data-rd-name]");
    const tag = q("[data-rd-tag]");
    const link = q<HTMLAnchorElement>("[data-rd-link]");

    let on = 0;
    const select = (i: number) => {
      if (i === on) return;
      spines[on].classList.remove("is-on");
      spines[on].removeAttribute("aria-current");
      on = i;
      const s = spines[i];
      const d = s.dataset;
      s.classList.add("is-on");
      s.setAttribute("aria-current", "true");

      rd.dataset.group = d.group ?? "";
      if (d.img) {
        img.src = d.img;
        img.alt = d.alt ?? "";
        img.hidden = false;
        ph.hidden = true;
      } else {
        img.hidden = true;
        phName.textContent = d.name ?? "";
        ph.hidden = false;
      }
      num.textContent = d.num ?? "";
      kind.textContent = d.kind ?? "";
      status.className = `status status--${d.status}`;
      status.textContent = d.statusLabel ?? "";
      name.textContent = d.name ?? "";
      tag.textContent = d.tag ?? "";
      link.href = s.href;
      link.setAttribute("aria-label", `Open ${d.name}`);

      if (reduced) return;
      animate(shot, { opacity: [0.4, 1], scale: [0.98, 1] }, { duration: 0.4, ease: ARRIVE });
      animate([...body.children] as HTMLElement[], { opacity: [0, 1], y: [8, 0] }, { duration: 0.32, ease: ARRIVE, delay: stagger(0.03) });
    };

    // screenshots load on first approach, so pointing along the shelf never shows a blank frame
    let preloaded = false;
    const preload = () => {
      if (preloaded) return;
      preloaded = true;
      spines.forEach((s) => {
        if (s.dataset.img) new Image().src = s.dataset.img;
      });
    };

    spines.forEach((s, i) => {
      s.addEventListener(
        "pointerenter",
        (e) => {
          if (e.pointerType === "mouse") select(i);
        },
        { signal }
      );
      s.addEventListener("focus", () => select(i), { signal });
      // touch: the first finger tap pulls the book out, a second tap (or the reader's button) opens it.
      // Screen readers and keyboards activate without a touch pointerdown, so they open the link at once.
      let fingerTap = false;
      s.addEventListener("pointerdown", (e) => (fingerTap = e.pointerType === "touch"), { signal });
      s.addEventListener(
        "click",
        (e) => {
          const tapped = fingerTap;
          fingerTap = false;
          if (!tapped || finePointer() || i === on) return;
          e.preventDefault();
          select(i);
          // on a phone the reader sits under the shelves: bring it up if it's off screen
          const r = rd.getBoundingClientRect();
          if (r.top > window.innerHeight - 160) rd.scrollIntoView({ behavior: reduced ? "auto" : "smooth", block: "nearest" });
        },
        { signal }
      );
    });
    shelf.addEventListener("pointerenter", preload, { signal, once: true });
    shelf.addEventListener("touchstart", preload, { signal, once: true, passive: true });

    /* ---- filters: books outside the choice fade back; the shelf stays whole ---- */
    const bar = root.querySelector<HTMLElement>("[data-ix-filters]")!;
    const pill = bar.querySelector<HTMLElement>("[data-ix-pill]")!;
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>("[data-filter]")];
    const live = root.querySelector<HTMLElement>("[data-ix-status]")!;
    bar.hidden = false;

    const pillTo = (btn: HTMLElement, instant: boolean) => {
      const box = { x: btn.offsetLeft, y: btn.offsetTop, width: btn.offsetWidth, height: btn.offsetHeight };
      animate(pill, { ...box, opacity: 1 }, instant || reduced ? { duration: 0 } : SPRING);
    };
    const active = () => buttons.find((b) => b.classList.contains("is-active")) ?? buttons[0];
    pillTo(active(), true);
    new ResizeObserver(() => pillTo(active(), true)).observe(bar);

    const filter = (value: string) => {
      const match = (b: HTMLElement) => value === "all" || b.dataset.group === value;
      const picked: HTMLElement[] = [];
      books.forEach((b, i) => {
        const off = !match(b);
        b.classList.toggle("is-off", off);
        const s = spines[i];
        if (off) {
          s.tabIndex = -1;
          s.setAttribute("aria-hidden", "true");
        } else {
          s.removeAttribute("tabindex");
          s.removeAttribute("aria-hidden");
          picked.push(s);
        }
      });
      live.textContent = `Showing ${picked.length} of ${books.length} projects`;
      if (books[on].classList.contains("is-off")) select(spines.indexOf(picked[0] as HTMLAnchorElement));
      // the chosen books hop once, left to right, so the eye finds them
      if (!reduced && value !== "all") animate(picked, { y: [0, -10, 0] }, { duration: 0.42, ease: "easeOut", delay: stagger(0.04) });
    };

    buttons.forEach((btn) => {
      btn.addEventListener(
        "click",
        () => {
          if (btn.classList.contains("is-active")) return;
          buttons.forEach((b) => {
            b.classList.toggle("is-active", b === btn);
            b.setAttribute("aria-pressed", String(b === btn));
          });
          pillTo(btn, false);
          filter(btn.dataset.filter!);
        },
        { signal }
      );
    });
  };

  document.addEventListener("astro:page-load", wire);
</script>
