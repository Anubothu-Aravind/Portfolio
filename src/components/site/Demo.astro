---
import type { DemoKind } from "@/lib/projects";

interface Props {
  kind: DemoKind;
  label?: string;
  inline?: boolean;
}

const { kind, label, inline = false } = Astro.props;
const Tag = inline ? "span" : "figure";

// Sudoku: the classic puzzle and its solution. Givens stay, the rest fills in.
const solution = "534678912672195348198342567859761423426853791713924856961537284287419635345286179";
const puzzle = "530070000600195000098000060800060003400803001700020006060000280000419005000080079";
const fillOrder = (() => {
  const blanks = [...puzzle].map((c, i) => (c === "0" ? i : -1)).filter((i) => i >= 0);
  // deterministic shuffle so the fill looks like a solver hopping around, not a typewriter
  return blanks
    .map((i) => ({ i, k: (i * 37 + 11) % 81 }))
    .sort((a, b) => a.k - b.k)
    .map((x) => x.i);
})();

// Graph: two clusters joined by a few attack edges. Seeds are labelled; the rest learn by wave.
const nodes = [
  { x: 50, y: 60, c: "h", w: 0 },
  { x: 95, y: 35, c: "h", w: 1 },
  { x: 120, y: 85, c: "h", w: 1 },
  { x: 70, y: 120, c: "h", w: 1 },
  { x: 40, y: 165, c: "h", w: 2 },
  { x: 110, y: 160, c: "h", w: 2 },
  { x: 150, y: 125, c: "h", w: 2 },
  { x: 280, y: 50, c: "s", w: 0 },
  { x: 240, y: 30, c: "s", w: 1 },
  { x: 225, y: 85, c: "s", w: 1 },
  { x: 275, y: 115, c: "s", w: 1 },
  { x: 230, y: 150, c: "s", w: 2 },
  { x: 285, y: 170, c: "s", w: 2 },
];
const edges = [
  [0, 1], [0, 2], [0, 3], [1, 2], [2, 3], [3, 4], [3, 5], [2, 6], [5, 6], [4, 5],
  [7, 8], [7, 9], [7, 10], [8, 9], [9, 10], [10, 11], [10, 12], [11, 12], [9, 11],
  [6, 9], [6, 11],
];
---

<Tag class={`demo demo--${kind}`} data-demo aria-label={label ?? undefined} role={label ? "img" : undefined}>
  {
    kind === "route" && (
      <svg viewBox="0 0 320 200" aria-hidden="true">
        <g class="demo__streets">
          <path d="M10 170H310M10 120H310M10 60H310M10 100H310M10 30H310M10 140H310M10 180H310" />
          <path d="M30 10V190M90 10V190M120 10V190M170 10V190M210 10V190M250 10V190M290 10V190" />
        </g>
        <path class="demo__route demo__route--b" pathLength="1" d="M30 170H120V140H210V180H290" />
        <path class="demo__route demo__route--a" pathLength="1" d="M30 170V120H90V60H170V100H250V30H290" />
        <g class="demo__stops">
          <circle cx="90" cy="120" r="5" style="--d: 0.45s" />
          <circle cx="170" cy="60" r="5" style="--d: 0.9s" />
          <circle cx="250" cy="100" r="5" style="--d: 1.35s" />
          <circle cx="290" cy="30" r="5" style="--d: 1.8s" />
          <circle cx="210" cy="140" r="5" style="--d: 1.1s" />
          <circle cx="290" cy="180" r="5" style="--d: 1.6s" />
        </g>
        <rect class="demo__depot" x="22" y="162" width="16" height="16" rx="3" />
        <circle class="demo__van" r="6" />
      </svg>
    )
  }
  {
    kind === "sudoku" && (
      <svg viewBox="0 0 184 184" aria-hidden="true">
        <g class="demo__cells">
          {[...solution].map((digit, i) => {
            const given = puzzle[i] !== "0";
            const order = fillOrder.indexOf(i);
            return (
              <text
                x={2 + (i % 9) * 20 + 10}
                y={2 + Math.floor(i / 9) * 20 + 14.5}
                class={given ? "is-given" : "is-solved"}
                style={given ? undefined : `--d: ${(order * 0.032).toFixed(3)}s`}
              >
                {digit}
              </text>
            );
          })}
        </g>
        <g class="demo__grid">
          {Array.from({ length: 10 }, (_, k) => (
            <>
              <line x1={2 + k * 20} y1="2" x2={2 + k * 20} y2="182" class={k % 3 === 0 ? "is-thick" : undefined} />
              <line x1="2" y1={2 + k * 20} x2="182" y2={2 + k * 20} class={k % 3 === 0 ? "is-thick" : undefined} />
            </>
          ))}
        </g>
      </svg>
    )
  }
  {
    kind === "graph" && (
      <svg viewBox="0 0 320 200" aria-hidden="true">
        <g class="demo__edges">
          {edges.map(([a, b]) => (
            <line
              x1={nodes[a].x}
              y1={nodes[a].y}
              x2={nodes[b].x}
              y2={nodes[b].y}
              class={nodes[a].c !== nodes[b].c ? "is-attack" : undefined}
            />
          ))}
        </g>
        <g class="demo__nodes">
          {nodes.map((n) => (
            <circle
              cx={n.x}
              cy={n.y}
              r={n.w === 0 ? 9 : 7}
              class={`is-${n.c === "h" ? "honest" : "sybil"} ${n.w === 0 ? "is-seed" : ""}`}
              style={`--d: ${(n.w * 0.55).toFixed(2)}s`}
            />
          ))}
        </g>
      </svg>
    )
  }
  {
    kind === "tcp" && (
      <svg viewBox="0 0 320 200" aria-hidden="true">
        <g class="demo__hosts">
          <line x1="70" y1="28" x2="70" y2="192" />
          <line x1="250" y1="28" x2="250" y2="192" />
          <text x="70" y="18">client</text>
          <text x="250" y="18">server</text>
        </g>
        <g class="demo__packets">
          <path class="is-data" pathLength="1" d="M70 36L250 56" style="--d: 0s" />
          <path class="is-ack" pathLength="1" d="M250 58L70 78" style="--d: 0.35s" />
          <path class="is-data" pathLength="1" d="M70 82L250 102" style="--d: 0.7s" />
          <path class="is-lost" pathLength="1" d="M70 96L160 106" style="--d: 1.05s" />
          <path class="is-ack" pathLength="1" d="M250 104L70 124" style="--d: 1.4s" />
          <path class="is-retx" pathLength="1" d="M70 140L250 160" style="--d: 1.9s" />
          <path class="is-ack" pathLength="1" d="M250 162L70 182" style="--d: 2.3s" />
        </g>
        <g class="demo__drop" style="--d: 1.35s">
          <path d="M156 98l10 10M166 98l-10 10" />
        </g>
      </svg>
    )
  }
</Tag>

<style>
  .demo {
    display: block;
    margin: 0;
    width: 100%;
    color: var(--ink);
  }

  .demo svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* ---------- route ---------- */
  .demo__streets path {
    stroke: var(--line);
    stroke-width: 1;
    fill: none;
  }

  .demo__route {
    fill: none;
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .demo__route--a {
    stroke: var(--signal);
  }

  .demo__route--b {
    stroke: var(--ink);
    opacity: 0.55;
  }

  .demo__stops circle {
    fill: var(--card);
    stroke: var(--ink);
    stroke-width: 2;
  }

  .demo__depot {
    fill: var(--ink);
  }

  .demo__van {
    fill: var(--signal);
    stroke: var(--card);
    stroke-width: 2;
    offset-path: path("M30 170V120H90V60H170V100H250V30H290");
    offset-distance: 100%;
    offset-rotate: 0deg;
  }

  :global(.js) .demo:not(.is-playing) .demo__route {
    stroke-dashoffset: 1;
  }

  :global(.js) .demo:not(.is-playing) .demo__van {
    offset-distance: 0%;
  }

  .demo.is-playing .demo__route--a {
    animation: draw 2.2s var(--ease-out) both;
  }

  .demo.is-playing .demo__route--b {
    animation: draw 2s 0.25s var(--ease-out) both;
  }

  .demo.is-playing .demo__van {
    animation: drive 2.2s var(--ease-out) both;
  }

  .demo.is-playing .demo__stops circle {
    animation: ping 0.5s var(--d) var(--ease-spring) both;
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes drive {
    from {
      offset-distance: 0%;
    }
    to {
      offset-distance: 100%;
    }
  }

  @keyframes ping {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.6);
      fill: var(--mark);
    }
    100% {
      transform: scale(1);
    }
  }

  .demo__stops circle {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* ---------- sudoku ---------- */
  .demo__grid line {
    stroke: var(--line);
    stroke-width: 1;
  }

  .demo__grid line.is-thick {
    stroke: var(--ink);
    stroke-width: 1.6;
  }

  .demo__cells text {
    font-family: var(--font-mono);
    font-size: 11px;
    text-anchor: middle;
    fill: var(--ink);
  }

  .demo__cells text.is-solved {
    fill: var(--signal);
    font-weight: 500;
  }

  :global(.js) .demo:not(.is-playing) .demo__cells text.is-solved {
    opacity: 0;
  }

  .demo.is-playing .demo__cells text.is-solved {
    animation: pop 0.32s var(--d) var(--ease-spring) both;
    transform-box: fill-box;
    transform-origin: center;
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- graph ---------- */
  .demo__edges line {
    stroke: var(--line);
    stroke-width: 1.5;
  }

  .demo__edges line.is-attack {
    stroke: var(--signal);
    stroke-dasharray: 3 4;
    opacity: 0.7;
  }

  .demo__nodes circle {
    stroke: var(--card);
    stroke-width: 2;
    transform-box: fill-box;
    transform-origin: center;
  }

  .demo__nodes .is-honest {
    fill: var(--ok);
  }

  .demo__nodes .is-sybil {
    fill: var(--signal);
  }

  .demo__nodes .is-seed {
    stroke: var(--ink);
    stroke-width: 2.5;
  }

  :global(.js) .demo:not(.is-playing) .demo__nodes circle:not(.is-seed) {
    fill: var(--paper-2);
  }

  .demo.is-playing .demo__nodes circle:not(.is-seed) {
    animation: learn-h 0.5s calc(var(--d) + 0.2s) var(--ease-out) both;
  }

  .demo.is-playing .demo__nodes circle.is-sybil:not(.is-seed) {
    animation-name: learn-s;
  }

  @keyframes learn-h {
    from {
      fill: var(--paper-2);
      transform: scale(0.8);
    }
    to {
      fill: var(--ok);
      transform: none;
    }
  }

  @keyframes learn-s {
    from {
      fill: var(--paper-2);
      transform: scale(0.8);
    }
    to {
      fill: var(--signal);
      transform: none;
    }
  }

  /* ---------- tcp ---------- */
  .demo__hosts line {
    stroke: var(--ink);
    stroke-width: 2;
  }

  .demo__hosts text {
    font-family: var(--font-mono);
    font-size: 11px;
    text-anchor: middle;
    fill: var(--muted);
  }

  .demo__packets path {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .demo__packets .is-data {
    stroke: var(--ink);
  }

  .demo__packets .is-ack {
    stroke: var(--ok);
  }

  .demo__packets .is-lost,
  .demo__packets .is-retx {
    stroke: var(--signal);
  }

  .demo__drop path {
    stroke: var(--signal);
    stroke-width: 2.5;
    stroke-linecap: round;
    fill: none;
  }

  :global(.js) .demo:not(.is-playing) .demo__packets path {
    stroke-dashoffset: 1;
  }

  :global(.js) .demo:not(.is-playing) .demo__drop {
    opacity: 0;
  }

  .demo.is-playing .demo__packets path {
    animation: draw 0.4s var(--d) linear both;
  }

  .demo.is-playing .demo__drop {
    animation: fade 0.2s var(--d) linear both;
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>

<script>
  const play = (el: HTMLElement) => {
    el.classList.remove("is-playing");
    void el.getBoundingClientRect();
    el.classList.add("is-playing");
  };

  const wire = () => {
    const demos = document.querySelectorAll<HTMLElement>("[data-demo]:not([data-wired])");
    if (!demos.length) return;
    const io =
      "IntersectionObserver" in window
        ? new IntersectionObserver(
            (entries) => {
              entries.forEach((e) => {
                if (e.isIntersecting) {
                  play(e.target as HTMLElement);
                  io?.unobserve(e.target);
                }
              });
            },
            { threshold: 0.35 }
          )
        : null;
    demos.forEach((demo) => {
      demo.dataset.wired = "1";
      if (io) io.observe(demo);
      else demo.classList.add("is-playing");
      const host = demo.closest<HTMLElement>("[data-demo-host]") ?? demo;
      host.addEventListener("pointerenter", () => play(demo));
      host.addEventListener("focusin", () => play(demo));
    });
  };

  document.addEventListener("astro:page-load", wire);
</script>
